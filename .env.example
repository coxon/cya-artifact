# Helper scripts use these values. Copy to ignored .env and replace placeholders.
# Load explicitly: set -a; source .env; set +a
ARTIFACT_BASE_URL=https://your-worker.your-subdomain.workers.dev
ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Alternative to ADMIN_TOKEN: an explicit path to a local token file.
# ADMIN_TOKEN_FILE=/path/to/your/admin-token-file

# Optional direct-API deploy.mjs / set_secret.mjs configuration.
# Standard Wrangler deployment does not require these variables in this file.
CF_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CF_WORKER_NAME=cya-artifact
# Only required for deploy.mjs --domain; set ARTIFACT_BASE_URL to your HTTPS hostname.
# CF_ZONE_ID=your-cloudflare-zone-id

# Optional Worker webhook secrets (set through Wrangler, not by sourcing this file).
# ROUTINE_WEBHOOK_URL=https://your-generator.example.com/webhook
# ROUTINE_SENDER_KEY=replace-with-a-webhook-authentication-key
# Legacy alias, used only when ROUTINE_SENDER_KEY is absent:
# ROUTINE_SENDER_KEY_ARTIFACT=replace-with-a-webhook-authentication-key
# EDITOR_WEBHOOK_URL=https://your-editor.example.com/webhook
# EDITOR_SENDER_KEY=replace-with-a-webhook-authentication-key
